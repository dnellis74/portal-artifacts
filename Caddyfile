{
	# Redact launch tokens and session headers from runtime/error logs as well.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Public game assets must be readable by scripts-only sandbox embeds.
	@cosmic path /cosmic-carnival/*
	header @cosmic Access-Control-Allow-Origin "*"
	header @cosmic Cache-Control "no-cache"

	# Revalidate walker assets so repeat visitors receive new deployments.
	@field path /field /field/*
	header @field Cache-Control "no-cache"

	@lunar path /lunar-republic /lunar-republic/*
	header @lunar Cache-Control "no-cache"

	@walker path /desert-walker /desert-walker/*
	header @walker Cache-Control "no-cache"

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://portal.raidguild.org https://*.up.railway.app http://localhost:*"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	route {
		# One published film only. Existing media service authenticates to Railway S3.
		@launch_film {
			method GET HEAD
			path /raidguild-launch-film/media/film.mp4
		}
		handle @launch_film {
			rewrite * /render-outputs/remotion/raidguild-launch-film/v15/film-c3df72bd378c1529.mp4
			reverse_proxy https://remotion-service-production.up.railway.app {
				header_up Host remotion-service-production.up.railway.app
				header_up -Authorization
				header_up -Cookie
				header_down -Set-Cookie
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}
		handle /raidguild-launch-film/media/* {
			respond "Film media route not found" 404
		}

		# Visitor-owned TypeSafe keys only. Fixed upstream and endpoint; no env key.
		@jev_inference {
			method POST
			path /jev-api/systemone
			header Authorization "Bearer *"
		}
		handle @jev_inference {
			request_body {
				max_size 100KB
			}
			header Cache-Control "no-store"
			rewrite * /v1/systemone
			reverse_proxy https://api.typesafe.ai {
				header_up Host api.typesafe.ai
				header_up -Cookie
				header_up -X-Jev-Key
				header_down -Set-Cookie
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
				}
			}
		}
		handle /jev-api/* {
			respond "Jev API route or authorization not allowed" 404
		}

		# Optional game backend; same-origin requests preserve first-party sessions.
		# The service remains usable without this backend (guest/local mode).
		handle /leaderboard-api/cosmic-carnival/* {
			reverse_proxy {$LEADERBOARD_UPSTREAM:localhost:9999} {
				header_up Host {upstream_hostport}
				transport http {
					dial_timeout 3s
					response_header_timeout 8s
				}
			}
		}
		handle /health {
			respond "ok" 200
		}

		@veydrift_mission_explorer path_regexp mission_explorer ^/veydrift-mission-explorer/mission/[0-9]+/?$
		rewrite @veydrift_mission_explorer /veydrift-mission-explorer/index.html

		@veydrift_read {
			method GET HEAD
			path_regexp veydrift ^/veydrift-api/(runtime-config|alliance/[0-9]+|wallet/0x[a-fA-F0-9]{40}/(profile|planets|missions|queues|fleet-visibility|shipyard|defenses|alliance)|missions|mission/[0-9]+|planets/[0-9]+|universe/(systems|system|galaxies/[0-9]+/systems/[0-9]+))$
		}

		handle @veydrift_read {
			uri strip_prefix /veydrift-api
			reverse_proxy https://api.veydrift.com {
				header_up -Authorization
				header_up -Cookie
				transport http {
					dial_timeout 3s
					response_header_timeout 10s
				}
			}
		}

		handle /veydrift-api/* {
			respond "Veydrift API route not allowed" 404
		}

		handle {
			file_server
		}
	}
}

!/studies/raidguild-launch-film/audio/*.json
/studies/raidguild-launch-film/assets/video/*
!/studies/raidguild-launch-film/assets/video/*.md
!/studies/raidguild-launch-film/assets/video/*.json
/studies/raidguild-launch-film/render/
/studies/raidguild-launch-film/exports/
/studies/raidguild-launch-film/__pycache__/
/studies/raidguild-launch-film/**/__pycache__/
/studies/raidguild-launch-film/**/Grinder*.woff2
